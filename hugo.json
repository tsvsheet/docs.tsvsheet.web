{
  "baseURL": "https://tsvsheet.github.io/docs.tsvsheet.web/",
  "title": "tsvsheet.web",
  "publishDir": "_site",
  "enableRobotsTXT": true,
  "markup": {
    "goldmark": {
      "renderHooks": {
        "link": {
          "useEmbedded": "fallback"
